{
  "expo": {
    "name": "Raider Syndicate",
    "slug": "raider-syndicate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icons/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.raidersyndicate.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.raidersyndicate.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-font"]
  }
}
